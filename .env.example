# Documentation only: Django reads process environment; this file is not auto-loaded.
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_PRIVATE_KEY
DJANGO_DEBUG=false
DJANGO_TIME_ZONE=America/Caracas
DJANGO_ALLOWED_HOSTS=medicina.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://medicina.example.invalid
# Absolute path outside the repository, configured explicitly before migrations.
DJANGO_DB_PATH=C:/private/uptag/medical.sqlite3
# Local development ONLY: DJANGO_DEBUG=true and localhost,127.0.0.1 as hosts.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
